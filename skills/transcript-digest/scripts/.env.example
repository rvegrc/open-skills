# chunk-and-label.ts config — copy to `.env`.
# Precedence: CLI flags > process env > this file.
# Everything else (endpoint, model, api key) can be passed as flags:
#   --endpoint URL --model NAME --api-key KEY

# Context budget — required for --mode summary and for chapter derivation.
# Set your model's REAL context window:
TRANSCRIBE_CONTEXT_TOKENS=262144

# Or a named shorthand instead (an explicit TRANSCRIBE_CONTEXT_TOKENS wins over it):
#   sonnet | opus 200k   gpt | deepseek 128k   qwen-27b | gemma-30b 32k
# TRANSCRIBE_PROFILE=qwen-27b

# Too small only costs extra calls for summaries — but chapter derivation needs the
# WHOLE transcript in one call, so an under-set budget fails the run outright.
# Models below ~27B are unsupported — see ../docs/speaker-identification.md.
